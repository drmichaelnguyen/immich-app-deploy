# Copy to .env and fill in local paths. Do not commit .env.

UPLOAD_LOCATION=/path/to/immich/library
DB_DATA_LOCATION=/path/to/immich/postgres
# Keep this aligned with the custom source branch and package versions.
IMMICH_VERSION=v3.2.2
DB_PASSWORD=change-me
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

SERVER_WORKERS=1
MACHINE_LEARNING_WORKERS=1
IMMICH_MACHINE_LEARNING_URL=http://immich-machine-learning:3003
